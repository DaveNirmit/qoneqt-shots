# Copy this file to .env and fill in your key. .env is ignored by git.
GEMINI_API_KEY=
# Keep the paid Veo video model off (uses Gemini images + local motion instead)
GEMINI_VIDEO=off
# Optional overrides
# GEMINI_TEXT_MODEL=gemini-3-flash-preview
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Optional: free account token from https://auth.pollinations.ai for faster, watermark-free scene images
POLLINATIONS_TOKEN=
